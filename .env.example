# Copy to .env.local at the repository root. Do not commit that file.
# Database scripts and the Next.js app both read the root file.
# Shell variables override these files.
#
# Server-only. Never use a NEXT_PUBLIC_ prefix for these values.
# The browser bundle only inlines NEXT_PUBLIC_* variables.

# Application runtime connection.
# Supabase: shared pooler, transaction mode, port 6543.
# Local Postgres: a single postgresql:// URL is enough; DIRECT_URL can be omitted.
DATABASE_URL=postgresql://postgres:[password]@127.0.0.1:5432/postgres

# Migrations and other session-level commands.
# Supabase: direct connection, or the session pooler on port 5432.
# Omit locally when it is the same database as DATABASE_URL.
DIRECT_URL=postgresql://postgres:[password]@127.0.0.1:5432/postgres
